diff --git a/ps2xRuntime/include/runtime/gs/gs_threaded_backend.h b/ps2xRuntime/include/runtime/gs/gs_threaded_backend.h
new file mode 100644
index 0000000..43fe622
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_threaded_backend.h
@@ -0,0 +1,173 @@
+#pragma once
+
+#include "runtime/gs/gs_backend.h"
+#include "runtime/gs/gs_cpu_backend.h"
+
+#include <array>
+#include <barrier>
+#include <condition_variable>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+// Draws on worker threads, in submission order, so the EE can keep going while the GS
+// draws. Each worker has its own CPU backend over the shared VRAM and draws every
+// worker-count-th band of rows, so a pixel is always drawn by the same worker, in
+// order. Transfers, VRAM writes, presentation and any draw that reads what another
+// worker may be writing (or writes what one may be reading) run on one worker while
+// the others wait at that point in the stream. Calls that return VRAM contents wait
+// for the queued work first, so everything the guest can read back is unchanged. Each
+// command runs in the rounding mode its caller had (VU1 XGKICK draws run toward zero).
+// Presentation never waits: a frame is captured in order with the draws and returned
+// by a later call.
+class GSThreadedBackend final : public GSRasterBackend
+{
+public:
+    explicit GSThreadedBackend(unsigned workerCount = 1u);
+    ~GSThreadedBackend() override;
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+private:
+    enum class CommandKind : uint8_t
+    {
+        Submit,
+        LoadClut,
+        BeginTransfer,
+        UploadImage,
+        TextureFlush,
+        ClearFramebuffer,
+        WriteVram,
+        Present,
+    };
+
+    struct Command
+    {
+        CommandKind kind = CommandKind::Submit;
+        int roundingMode = 0;
+        // Every worker finishes the commands before this one first.
+        bool waitForAll = false;
+        // Runs once, on the first worker's backend, for all rows, while the others wait.
+        bool runAlone = false;
+        GSPrimitiveBatch batch{};
+        GSTex0Reg tex0{};
+        GSTexClutReg texclut{};
+        GSTransferCommand transfer{};
+        std::vector<uint8_t> data;
+        uint32_t args[6]{};
+    };
+
+    // The VRAM pages (8 KiB each) that commands since the workers last waited for each
+    // other have drawn to or read as textures.
+    class PageTracker
+    {
+    public:
+        static constexpr uint32_t kPageCount = 512u;
+        using PageSet = std::array<uint64_t, kPageCount / 64u>;
+
+        // Pages a command draws to through one buffer layout.
+        struct Access
+        {
+            uint32_t layout = 0;
+            PageSet pages{};
+        };
+
+        static void AddPages(PageSet &pages, uint32_t block, uint32_t bw, uint32_t psm,
+                             int x0, int y0, int x1, int y1);
+        static bool Intersects(const PageSet &a, const PageSet &b);
+
+        void Clear();
+        // Whether a command drawing to `drawn` and texturing from `textured` must wait
+        // for the earlier commands on every worker.
+        bool Conflicts(const Access *drawn, size_t count, const PageSet &textured) const;
+        void Add(const Access *drawn, size_t count, const PageSet &textured);
+
+    private:
+        PageSet m_drawn{};
+        PageSet m_textured{};
+        std::array<uint32_t, kPageCount> m_layout{};
+    };
+
+    struct BarrierCompletion
+    {
+        GSThreadedBackend *self;
+        void operator()() noexcept;
+    };
+
+    struct Worker
+    {
+        std::unique_ptr<GSCpuBackend> backend;
+        std::thread thread;
+    };
+
+    Command &beginCommand(std::unique_lock<std::mutex> &lock, CommandKind kind, bool mayWait = true);
+    void endCommand(std::unique_lock<std::mutex> &lock);
+    void startBatchLocked();
+    void waitForQueuedWork() const;
+    void classifySubmit(Command &command);
+    // readsOwnPixels: each pixel the draw writes to drawn[0] reads only itself.
+    void classifyDraw(Command &command, const PageTracker::Access *drawn, size_t count,
+                      const PageTracker::PageSet &textured, bool readsOwnPixels);
+    void markRunAlone(Command &command);
+    // The end of the run of commands from m_working[begin], a runAlone one, that
+    // the barrier can run in one go: runAlone commands, and the CLUT loads and
+    // texture flushes between them, which it runs on every worker's backend.
+    size_t aloneRunEnd(size_t begin) const;
+    void runCommand(GSCpuBackend &backend, const Command &command);
+    void runAlone(const Command &command);
+    void workerMain(size_t index);
+
+    std::vector<Worker> m_workers;
+    uint8_t *m_vram = nullptr;
+
+    mutable std::mutex m_queueMutex;
+    mutable std::condition_variable m_workAvailable;
+    mutable std::condition_variable m_workDone;
+    std::vector<Command> m_pending;
+    std::vector<Command> m_working;
+    uint64_t m_submitted = 0;
+    uint64_t m_completed = 0;
+    uint64_t m_lastTransferCommand = 0;
+    uint64_t m_batchGeneration = 0;
+    size_t m_workersDone = 0;
+    bool m_batchRunning = false;
+    bool m_stopping = false;
+    PageTracker m_pages;
+
+    std::barrier<BarrierCompletion> m_barrier;
+    // The commands the barrier runs once every worker has arrived,
+    // m_working[m_aloneBegin, m_aloneEnd), set by the first worker. Empty for a
+    // plain wait.
+    size_t m_aloneBegin = 0;
+    size_t m_aloneEnd = 0;
+
+    mutable std::mutex m_transferMutex;
+    GSTransferSnapshot m_transferSnapshot{};
+
+    // A presentation request waits in the queue until the draws before it are done.
+    // m_presentMutex guards the flag and the last captured frame.
+    GSPresentationRequest m_presentRequest{};
+    mutable std::mutex m_presentMutex;
+    bool m_presentQueued = false;
+    PresentationFrame m_lastPresented;
+};
