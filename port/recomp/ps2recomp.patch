+    // sample's texel centre at or before it and the next one.
+    const bool linear = state.linearFilter;
+    const auto range = [&](uint16_t firstUV, uint16_t lastUV, int unclipped, float span, int drawFirst, int drawLast,
+                           int &first, int &last)
+    {
+        const float firstCoordinate = static_cast<float>(firstUV >> 4);
+        const float lastCoordinate = static_cast<float>(lastUV >> 4);
+        const auto texel = [&](int pixel)
+        {
+            const float coordinate = static_cast<float>(fixedTexelCoordinate(
+                                         spriteTexelCoordinate(firstCoordinate, lastCoordinate, pixel - unclipped, span))) /
+                                     16.0f;
+            return linear ? static_cast<int>(std::floor(coordinate - 0.5f)) : static_cast<int>(coordinate);
+        };
+        const int a = texel(drawFirst);
+        const int b = texel(drawLast);
+        first = std::min(a, b);
+        last = std::max(a, b) + (linear ? 1 : 0);
