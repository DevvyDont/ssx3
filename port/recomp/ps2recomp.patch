+    // Two buffers with the same layout put each pixel at the same address, so the same
+    // worker draws it whichever of them a draw goes through.
+    uint32_t layoutKey(uint32_t block, uint32_t bw, uint32_t psm)
+    {
+        if (psm == GS_PSM_CT24)
+            psm = GS_PSM_CT32;
+        else if (psm == GS_PSM_Z24)
+            psm = GS_PSM_Z32;
+        return 0x80000000u | (block & 0x3FFFu) | ((bw & 0x3Fu) << 14u) | ((psm & 0x3Fu) << 20u);
+    }
