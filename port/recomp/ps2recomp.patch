+
+    // The texel columns (or rows) that coordinates in [lo, hi] reach after wrapping.
+    void wrapTexelRange(float lo, float hi, bool bounded, int size, uint32_t mode, int regionMin, int regionMax,
+                        int &first, int &last)
+    {
+        first = 0;
+        last = size - 1;
+        if (mode == 3u)
+        {
+            // REGION_REPEAT
+            last = std::max(last, regionMin | regionMax);
+            return;
+        }
+        if (!bounded)
+        {
+            if (mode == 2u)
+                last = std::max(last, std::max(regionMin, regionMax));
+            return;
+        }
+
+        const int lowest = static_cast<int>(std::floor(lo));
+        const int highest = static_cast<int>(std::ceil(hi));
+        switch (mode)
+        {
+        case 0u: // REPEAT
+            if (lowest >= 0 && highest < size)
+            {
+                first = lowest;
+                last = highest;
+            }
+            break;
+        case 1u: // CLAMP
+            first = std::clamp(lowest, 0, size - 1);
+            last = std::clamp(highest, 0, size - 1);
+            break;
+        default: // REGION_CLAMP
+            first = std::min(std::max(lowest, regionMin), regionMax);
+            last = std::min(std::max(highest, regionMin), regionMax);
+            break;
+        }
+    }
+}
+
+void GSThreadedBackend::PageTracker::AddPages(PageSet &pages, uint32_t block, uint32_t bw, uint32_t psm,
+                                              int x0, int y0, int x1, int y1)
+{
+    if (x1 < x0 || y1 < y0)
+        return;
+
+    // The same page arithmetic as GSMem's addressing. A base that is not page aligned
+    // spreads every page over two.
+    const PageExtent extent = pageExtent(psm);
+    const uint32_t pagesPerRow = (bw * 64u) / extent.width;
+    const uint32_t firstPage = block / 32u;
+    const bool straddles = (block % 32u) != 0u;
+    const uint32_t row0 = static_cast<uint32_t>(std::max(y0, 0)) / extent.height;
+    const uint32_t row1 = static_cast<uint32_t>(std::max(y1, 0)) / extent.height;
+    const uint32_t col0 = static_cast<uint32_t>(std::max(x0, 0)) / extent.width;
+    const uint32_t col1 = static_cast<uint32_t>(std::max(x1, 0)) / extent.width;
+    if ((row1 - row0 + 1u) * (col1 - col0 + 1u) >= kPageCount)
+    {
+        pages.fill(~0ull);
+        return;
+    }
+
+    for (uint32_t row = row0; row <= row1; ++row)
+    {
+        for (uint32_t col = col0; col <= col1; ++col)
+        {
+            const uint32_t page = (firstPage + row * pagesPerRow + col) % kPageCount;
+            pages[page / 64u] |= 1ull << (page % 64u);
+            if (straddles)
+            {
+                const uint32_t next = (page + 1u) % kPageCount;
+                pages[next / 64u] |= 1ull << (next % 64u);
+            }
+        }
+    }
+}
+
+bool GSThreadedBackend::PageTracker::Intersects(const PageSet &a, const PageSet &b)
+{
+    uint64_t any = 0;
+    for (size_t i = 0; i < a.size(); ++i)
+        any |= a[i] & b[i];
+    return any != 0u;
+}
+
+void GSThreadedBackend::PageTracker::Clear()
+{
+    m_drawn.fill(0u);
+    m_textured.fill(0u);
+}
+
+bool GSThreadedBackend::PageTracker::Conflicts(const Access *drawn, size_t count, const PageSet &textured) const
+{
+    // Reading pages another worker may still be drawing to.
+    if (Intersects(textured, m_drawn))
+        return true;
+
+    for (size_t i = 0; i < count; ++i)
+    {
+        // Drawing to pages another worker may still be reading.
+        if (Intersects(drawn[i].pages, m_textured))
+            return true;
+
+        // Drawing through another layout puts pixels on rows another worker draws.
+        for (size_t word = 0; word < drawn[i].pages.size(); ++word)
+        {
+            uint64_t both = drawn[i].pages[word] & m_drawn[word];
+            while (both != 0u)
+            {
+                const uint32_t page = static_cast<uint32_t>(word * 64u) + static_cast<uint32_t>(__builtin_ctzll(both));
+                if (m_layout[page] != drawn[i].layout)
+                    return true;
+                both &= both - 1u;
+            }
+        }
+    }
+    return false;
+}
+
+void GSThreadedBackend::PageTracker::Add(const Access *drawn, size_t count, const PageSet &textured)
+{
+    for (size_t word = 0; word < m_textured.size(); ++word)
+        m_textured[word] |= textured[word];
+
+    for (size_t i = 0; i < count; ++i)
+    {
+        for (size_t word = 0; word < m_drawn.size(); ++word)
+        {
+            uint64_t fresh = drawn[i].pages[word] & ~m_drawn[word];
+            while (fresh != 0u)
+            {
+                const uint32_t page = static_cast<uint32_t>(word * 64u) + static_cast<uint32_t>(__builtin_ctzll(fresh));
+                m_layout[page] = drawn[i].layout;
+                fresh &= fresh - 1u;
+            }
+            m_drawn[word] |= drawn[i].pages[word];
+        }
+    }
+}
+
+void GSThreadedBackend::BarrierCompletion::operator()() noexcept
+{
+    for (size_t i = self->m_aloneBegin; i < self->m_aloneEnd; ++i)
+    {
+        const Command &command = self->m_working[i];
+        try
+        {
+            if (command.runAlone)
+            {
+                self->runAlone(command);
+            }
+            else
+            {
+                for (Worker &worker : self->m_workers)
+                    self->runCommand(*worker.backend, command);
+            }
+        }
+        catch (...)
+        {
+            // A failed command must not take the workers, and every later draw, with it.
+        }
+    }
+}
+
+GSThreadedBackend::GSThreadedBackend(unsigned workerCount)
+    : m_barrier(static_cast<std::ptrdiff_t>(std::max(workerCount, 1u)), BarrierCompletion{this})
+{
+    const unsigned count = std::max(workerCount, 1u);
+    m_workers.resize(count);
+    for (unsigned i = 0; i < count; ++i)
+    {
+        m_workers[i].backend = std::make_unique<GSCpuBackend>();
+        m_workers[i].backend->SetRowBand(i, count);
+    }
+    m_pending.reserve(1024u);
+    m_working.reserve(1024u);
+    for (size_t i = 0; i < m_workers.size(); ++i)
+        m_workers[i].thread = std::thread([this, i]() { workerMain(i); });
+}
+
+GSThreadedBackend::~GSThreadedBackend()
+{
+    waitForQueuedWork();
+    {
+        std::lock_guard<std::mutex> lock(m_queueMutex);
+        m_stopping = true;
+    }
+    m_workAvailable.notify_all();
+    for (Worker &worker : m_workers)
+    {
+        if (worker.thread.joinable())
+            worker.thread.join();
+    }
+}
+
+GSThreadedBackend::Command &GSThreadedBackend::beginCommand(std::unique_lock<std::mutex> &lock, CommandKind kind, bool mayWait)
+{
+    if (mayWait && m_pending.size() >= kMaxPendingCommands)
+        m_workDone.wait(lock, [this]() { return m_pending.size() < kMaxPendingCommands; });
+    Command &command = m_pending.emplace_back();
+    command.kind = kind;
+    command.roundingMode = std::fegetround();
+    return command;
+}
+
+void GSThreadedBackend::endCommand(std::unique_lock<std::mutex> &lock)
+{
+    ++m_submitted;
+    if (!m_batchRunning)
+        startBatchLocked();
+    lock.unlock();
+}
+
+void GSThreadedBackend::startBatchLocked()
+{
+    if (m_pending.empty())
+    {
+        m_batchRunning = false;
+        return;
+    }
+    m_working.swap(m_pending);
+    m_batchRunning = true;
+    ++m_batchGeneration;
+    m_workAvailable.notify_all();
+}
+
+void GSThreadedBackend::waitForQueuedWork() const
+{
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    const uint64_t target = m_submitted;
+    m_workDone.wait(lock, [this, target]() { return m_completed >= target; });
+}
+
+void GSThreadedBackend::markRunAlone(Command &command)
+{
+    command.runAlone = true;
+    m_pages.Clear();
+}
+
+size_t GSThreadedBackend::aloneRunEnd(size_t begin) const
+{
+    // Nothing between them draws, so the workers have nothing to do in between.
+    // SSX 3 sends a texture's mip levels as one transfer each, with a texture
+    // flush after each and a CLUT load after the last.
+    size_t end = begin + 1u;
+    while (end < m_working.size())
+    {
+        const Command &next = m_working[end];
+        if (!next.runAlone && next.kind != CommandKind::LoadClut && next.kind != CommandKind::TextureFlush)
+            break;
+        ++end;
+    }
+    return end;
+}
+
+void GSThreadedBackend::classifyDraw(Command &command, const PageTracker::Access *drawn, size_t count,
+                                     const PageTracker::PageSet &textured, bool readsOwnPixels)
+{
+    if (m_workers.size() <= 1u)
+        return;
+
+    // A draw that textures from its own target, or whose colour and depth buffers
+    // share pages, depends on the order its own pixels are drawn in. One whose pixels
+    // each read only themselves from the colour buffer (drawn[0]) does not.
+    bool alone = false;
+    for (size_t i = 0; i < count && !alone; ++i)
+    {
+        alone = !(readsOwnPixels && i == 0u) && PageTracker::Intersects(drawn[i].pages, textured);
+        for (size_t j = i + 1u; j < count && !alone; ++j)
+            alone = PageTracker::Intersects(drawn[i].pages, drawn[j].pages);
+    }
+    if (alone)
+    {
+        markRunAlone(command);
+        return;
+    }
+
+    // Its own worker drew every pixel it reads, unless an earlier draw reached those
+    // pages through another layout, which Conflicts checks along with the draws that
+    // may still be reading them. Nothing else can need what it reads.
+    static const PageTracker::PageSet kNoPages{};
+    const PageTracker::PageSet &reads = readsOwnPixels ? kNoPages : textured;
+    if (m_pages.Conflicts(drawn, count, reads))
+    {
+        command.waitForAll = true;
+        m_pages.Clear();
+    }
+    m_pages.Add(drawn, count, reads);
+}
+
+void GSThreadedBackend::classifySubmit(Command &command)
+{
+    if (m_workers.size() <= 1u)
+        return;
+
+    const GSDrawState &state = command.batch.state;
+    const GSContext &ctx = state.context;
+
+    size_t vertexCount = 0;
+    switch (state.prim.type)
+    {
+    case GS_PRIM_POINT:
+        vertexCount = 1u;
+        break;
+    case GS_PRIM_LINE:
+    case GS_PRIM_LINESTRIP:
+    case GS_PRIM_SPRITE:
+        vertexCount = 2u;
+        break;
+    case GS_PRIM_TRIANGLE:
+    case GS_PRIM_TRISTRIP:
+    case GS_PRIM_TRIFAN:
+        vertexCount = 3u;
+        break;
+    default:
+        return;
+    }
+
+    // The rows and columns the primitive can touch, with a pixel to spare each side.
+    const float ofx = static_cast<float>(ctx.xyoffset.ofx >> 4);
+    const float ofy = static_cast<float>(ctx.xyoffset.ofy >> 4);
+    float minX = command.batch.vertices[0].x - ofx;
+    float maxX = minX;
+    float minY = command.batch.vertices[0].y - ofy;
+    float maxY = minY;
+    for (size_t i = 1; i < vertexCount; ++i)
+    {
+        const float x = command.batch.vertices[i].x - ofx;
+        const float y = command.batch.vertices[i].y - ofy;
+        minX = std::min(minX, x);
+        maxX = std::max(maxX, x);
+        minY = std::min(minY, y);
+        maxY = std::max(maxY, y);
+    }
+    const int x0 = std::max<int>(clampToInt(std::floor(minX) - 1.0f, -1, 4096), ctx.scissor.x0);
+    const int x1 = std::min<int>(clampToInt(std::ceil(maxX) + 1.0f, -1, 4096), ctx.scissor.x1);
+    const int y0 = std::max<int>(clampToInt(std::floor(minY) - 1.0f, -1, 4096), ctx.scissor.y0);
+    const int y1 = std::min<int>(clampToInt(std::ceil(maxY) + 1.0f, -1, 4096), ctx.scissor.y1);
+
+    PageTracker::Access drawn[2]{};
+    size_t drawnCount = 0;
+    const uint32_t fbw = std::max<uint32_t>(ctx.frame.fbw, 1u);
+    if (x0 <= x1 && y0 <= y1)
+    {
+        const uint32_t fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+        drawn[drawnCount].layout = layoutKey(fbp, fbw, ctx.frame.psm);
+        PageTracker::AddPages(drawn[drawnCount].pages, fbp, fbw, ctx.frame.psm, x0, y0, x1, y1);
+        ++drawnCount;
+
+        const uint32_t ztestMethod = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+        if (ztestMethod >= 2u || (ztestMethod == 1u && !ctx.zbuf.zmask))
+        {
+            const uint32_t zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+            drawn[drawnCount].layout = layoutKey(zbp, fbw, ctx.zbuf.psm);
+            PageTracker::AddPages(drawn[drawnCount].pages, zbp, fbw, ctx.zbuf.psm, x0, y0, x1, y1);
+            ++drawnCount;
+        }
+    }
+
+    // A copy of the target onto itself reads exactly the pixels it draws.
+    const bool readsOwnPixels = drawnCount != 0u && readsOnlyItsOwnPixels(command.batch);
+    PageTracker::PageSet textured{};
+    if (readsOwnPixels)
+    {
+        textured = drawn[0].pages;
+    }
+    else if (state.prim.tme && drawnCount != 0u)
+    {
+        // A UV sprite's texels can be found exactly, with the maths DrawSprite uses (this
+        // runs in the rounding mode the draw will).
+        float minU = 0.0f, maxU = 0.0f, minV = 0.0f, maxV = 0.0f;
+        int spriteU0, spriteU1, spriteV0, spriteV1;
+        bool bounded = GSCpuBackend::SpriteTexelRange(command.batch, spriteU0, spriteU1, spriteV0, spriteV1);
+        if (bounded)
+        {
+            minU = static_cast<float>(spriteU0);
+            maxU = static_cast<float>(spriteU1);
+            minV = static_cast<float>(spriteV0);
+            maxV = static_cast<float>(spriteV1);
+        }
+        else
+        {
+            bounded = texelBounds(command.batch, vertexCount, minU, maxU, minV, maxV);
+        }
+        const uint64_t clamp = ctx.clamp;
+        int u0, u1, v0, v1;
+        wrapTexelRange(minU, maxU, bounded, std::max<int>(state.textureWidth, 1), clamp & 3u,
+                       static_cast<int>((clamp >> 4) & 0x3FFu), static_cast<int>((clamp >> 14) & 0x3FFu), u0, u1);
+        wrapTexelRange(minV, maxV, bounded, std::max<int>(state.textureHeight, 1), (clamp >> 2) & 3u,
+                       static_cast<int>((clamp >> 24) & 0x3FFu), static_cast<int>((clamp >> 34) & 0x3FFu), v0, v1);
+        PageTracker::AddPages(textured, ctx.tex0.tbp0, ctx.tex0.tbw, ctx.tex0.psm, u0, v0, u1, v1);
+    }
+
+    classifyDraw(command, drawn, drawnCount, textured, readsOwnPixels);
+}
+
+void GSThreadedBackend::runCommand(GSCpuBackend &backend, const Command &command)
+{
+    if (std::fegetround() != command.roundingMode)
+        std::fesetround(command.roundingMode);
+
+    switch (command.kind)
+    {
+    case CommandKind::Submit:
+        backend.Submit(command.batch);
+        break;
+    case CommandKind::LoadClut:
+        backend.LoadClut(command.tex0, command.texclut);
+        break;
+    case CommandKind::TextureFlush:
+        backend.TextureFlush();
+        break;
+    case CommandKind::ClearFramebuffer:
+        backend.ClearFramebuffer(command.batch.state.context, command.args[0]);
+        break;
+    default:
+        break;
+    }
+}
+
+void GSThreadedBackend::runAlone(const Command &command)
+{
+    GSCpuBackend &backend = *m_workers[0].backend;
+    if (std::fegetround() != command.roundingMode)
+        std::fesetround(command.roundingMode);
+
+    switch (command.kind)
+    {
+    case CommandKind::Submit:
+    case CommandKind::ClearFramebuffer:
+        backend.SetRowBand(0u, 1u);
+        runCommand(backend, command);
+        backend.SetRowBand(0u, static_cast<uint32_t>(m_workers.size()));
+        break;
+    case CommandKind::BeginTransfer:
+        backend.BeginTransfer(command.transfer);
+        break;
+    case CommandKind::UploadImage:
+        backend.UploadImage(command.data.data(), static_cast<uint32_t>(command.data.size()));
+        break;
+    case CommandKind::WriteVram:
+        backend.WriteVram(command.args[0], command.args[1], command.args[2], command.args[3], command.args[4], command.args[5]);
+        break;
+    case CommandKind::Present:
+    {
+        PresentationFrame frame = backend.Present(m_presentRequest);
+        {
+            std::lock_guard<std::mutex> lock(m_presentMutex);
+            m_lastPresented = std::move(frame);
+            m_presentQueued = false;
+        }
+        break;
+    }
+    default:
+        break;
+    }
+
+    if (command.kind == CommandKind::BeginTransfer || command.kind == CommandKind::UploadImage)
+    {
+        const GSTransferSnapshot snapshot = backend.GetTransferSnapshot();
+        std::lock_guard<std::mutex> lock(m_transferMutex);
+        m_transferSnapshot = snapshot;
+    }
+}
+
+void GSThreadedBackend::workerMain(size_t index)
+{
+    GSCpuBackend &backend = *m_workers[index].backend;
+    uint64_t seenGeneration = 0;
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    for (;;)
+    {
+        m_workAvailable.wait(lock, [this, seenGeneration]()
+                             { return m_stopping || m_batchGeneration != seenGeneration; });
+        if (m_batchGeneration == seenGeneration)
+            return;
+        seenGeneration = m_batchGeneration;
+        lock.unlock();
+
+        for (size_t i = 0; i < m_working.size(); ++i)
+        {
+            const Command &command = m_working[i];
+            if (command.waitForAll || command.runAlone)
+            {
+                const size_t end = command.runAlone ? aloneRunEnd(i) : i;
+                if (index == 0u)
+                {
+                    m_aloneBegin = i;
+                    m_aloneEnd = end;
+                }
+                m_barrier.arrive_and_wait();
+                if (command.runAlone)
+                {
+                    i = end - 1u;
+                    continue;
+                }
+            }
+            try
+            {
+                runCommand(backend, command);
+            }
+            catch (...)
+            {
+                // A failed draw must not take the worker, and every later draw, with it.
+            }
+        }
+
+        lock.lock();
+        if (++m_workersDone == m_workers.size())
+        {
+            m_workersDone = 0;
+            m_completed += m_working.size();
+            m_working.clear();
+            startBatchLocked();
+            m_workDone.notify_all();
+        }
+    }
+}
+
+void GSThreadedBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    waitForQueuedWork();
+    m_vram = vram;
+    for (Worker &worker : m_workers)
+        worker.backend->Initialize(vram, vramSize);
+    std::lock_guard<std::mutex> lock(m_transferMutex);
+    m_transferSnapshot = m_workers[0].backend->GetTransferSnapshot();
+}
+
+void GSThreadedBackend::Reset()
+{
+    waitForQueuedWork();
+    for (Worker &worker : m_workers)
+        worker.backend->Reset();
+    std::lock_guard<std::mutex> lock(m_transferMutex);
+    m_transferSnapshot = m_workers[0].backend->GetTransferSnapshot();
+}
+
+void GSThreadedBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    Command &command = beginCommand(lock, CommandKind::Submit);
+    command.batch = batch;
+    classifySubmit(command);
+    endCommand(lock);
+}
+
+void GSThreadedBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    Command &command = beginCommand(lock, CommandKind::LoadClut);
+    command.tex0 = tex0;
+    command.texclut = texclut;
+    if (m_workers.size() > 1u)
+    {
+        // Every worker loads its own copy of the CLUT from VRAM.
+        PageTracker::PageSet textured{};
+        if (tex0.csm == 0u)
+            PageTracker::AddPages(textured, tex0.cbp, 1u, tex0.cpsm, 0, 0, 15, 15);
+        else
+            PageTracker::AddPages(textured, tex0.cbp, texclut.cbw != 0u ? texclut.cbw : 1u, tex0.cpsm,
+                                  texclut.cou * 16, texclut.cov, texclut.cou * 16 + 255, texclut.cov);
+        classifyDraw(command, nullptr, 0u, textured, false);
+    }
+    endCommand(lock);
+}
+
+void GSThreadedBackend::BeginTransfer(const GSTransferCommand &transfer)
+{
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    Command &command = beginCommand(lock, CommandKind::BeginTransfer);
+    command.transfer = transfer;
+    markRunAlone(command);
+    m_lastTransferCommand = m_submitted + 1u;
+    endCommand(lock);
+}
+
+void GSThreadedBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    Command &command = beginCommand(lock, CommandKind::UploadImage);
+    if (data && sizeBytes != 0u)
+        command.data.assign(data, data + sizeBytes);
+    markRunAlone(command);
+    m_lastTransferCommand = m_submitted + 1u;
+    endCommand(lock);
+}
