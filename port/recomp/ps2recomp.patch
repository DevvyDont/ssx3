+        case GS_PSM_CT32:
+        case GS_PSM_CT24:
+        case GS_PSM_Z32:
+        case GS_PSM_Z24:
+        case GS_PSM_T8H:
+        case GS_PSM_T4HL:
+        case GS_PSM_T4HH:
