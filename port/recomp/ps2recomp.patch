+
+    const GSVertex &a = batch.vertices[0];
+    const GSVertex &b = batch.vertices[1];
+    range(a.u, b.u, rect.x0, static_cast<float>(rect.width), rect.drawX0, rect.drawX1, u0, u1);
+    range(a.v, b.v, rect.y0, static_cast<float>(rect.height), rect.drawY0, rect.drawY1, v0, v1);
+    return true;
 }
 
