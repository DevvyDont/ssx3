+bool VU1Interpreter::execFmacVector(uint32_t instr)
+{
+#if PS2X_VU_VECTOR_FMAC
+    const uint8_t op = static_cast<uint8_t>(instr & 0x3Fu);
+    const bool toAcc = op >= 0x3Cu;
+    const uint8_t code = toAcc ? static_cast<uint8_t>((instr & 3u) | ((instr >> 4) & 0x7Cu)) : op;
+
+    // The same forms as calculateFmacResultsDouble.
+    enum Form : uint8_t
+    {
+        Sum,
+        Difference,
+        Product,
+        AddProduct,
+        SubtractProduct
+    };
+    Form form;
+    const __m128 vt = normalizeOperands(_mm_loadu_ps(m_state.vf[FT(instr)]));
+    __m128 rhs;
+    if (code <= 0x0Fu || (code >= 0x18u && code <= 0x1Bu))
+    {
+        form = code <= 0x03u   ? Sum
+               : code <= 0x07u ? Difference
+               : code <= 0x0Bu ? AddProduct
+               : code <= 0x0Fu ? SubtractProduct
+                               : Product;
+        switch (code & 3u)
+        {
+        case 0u: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(0, 0, 0, 0)); break;
+        case 1u: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(1, 1, 1, 1)); break;
+        case 2u: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(2, 2, 2, 2)); break;
+        default: rhs = _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(3, 3, 3, 3)); break;
+        }
+    }
+    else if (code >= 0x1Cu && code <= 0x27u && (code == 0x1Cu || code == 0x1Eu || code >= 0x20u))
+    {
+        static constexpr Form forms[12] = {Product, Product, Product, Product, Sum, AddProduct,
+                                           Sum, AddProduct, Difference, SubtractProduct, Difference, SubtractProduct};
+        form = forms[code - 0x1Cu];
+        const bool usesI = code == 0x1Eu || (code >= 0x20u && (code & 2u) != 0u);
+        rhs = _mm_set1_ps(vuNormalizeOperand(usesI ? m_state.i : m_state.q));
+    }
+    else if (code == 0x28u || code == 0x29u || code == 0x2Au || code == 0x2Cu || code == 0x2Du)
+    {
+        form = code == 0x28u   ? Sum
+               : code == 0x29u ? AddProduct
+               : code == 0x2Au ? Product
+               : code == 0x2Cu ? Difference
+                               : SubtractProduct;
+        rhs = vt;
+    }
+    else
+        return false;
+
+    const uint8_t dest = DEST(instr);
+    if (dest == 0u)
+        return true; // no lanes written and no flags queued
+    const uint32_t components = kReverseLanes[dest];
+
+    const __m128 vs = normalizeOperands(_mm_loadu_ps(m_state.vf[FS(instr)]));
+    const __m128d vsLo = _mm_cvtps_pd(vs);
+    const __m128d vsHi = _mm_cvtps_pd(_mm_movehl_ps(vs, vs));
+    const __m128d rhsLo = _mm_cvtps_pd(rhs);
+    const __m128d rhsHi = _mm_cvtps_pd(_mm_movehl_ps(rhs, rhs));
+
+    __m128 result;
+    __m128d exactLo;
+    __m128d exactHi;
+    uint32_t productSticky = 0u;
+    switch (form)
+    {
+    case Sum:
+        result = _mm_add_ps(vs, rhs);
+        exactLo = _mm_add_pd(vsLo, rhsLo);
+        exactHi = _mm_add_pd(vsHi, rhsHi);
+        break;
+    case Difference:
+        result = _mm_sub_ps(vs, rhs);
+        exactLo = _mm_sub_pd(vsLo, rhsLo);
+        exactHi = _mm_sub_pd(vsHi, rhsHi);
+        break;
+    case Product:
+        result = _mm_mul_ps(vs, rhs);
+        exactLo = _mm_mul_pd(vsLo, rhsLo);
+        exactHi = _mm_mul_pd(vsHi, rhsHi);
+        break;
+    default:
+    {
+        const __m128 acc = normalizeOperands(_mm_loadu_ps(m_state.acc));
+        const __m128d accLo = _mm_cvtps_pd(acc);
+        const __m128d accHi = _mm_cvtps_pd(_mm_movehl_ps(acc, acc));
+        const __m128d productLo = _mm_mul_pd(vsLo, rhsLo);
+        const __m128d productHi = _mm_mul_pd(vsHi, rhsHi);
+        if ((normalComponents(productLo, productHi) & components) == components)
+            productSticky = (negativeComponents(productLo, productHi) & components) != 0u ? 0x2u : 0u;
+        else
+            productSticky = statusOf(classifyExact(productLo, productHi), components);
+        if (form == AddProduct)
+        {
+            result = _mm_add_ps(acc, _mm_mul_ps(vs, rhs));
+            exactLo = _mm_add_pd(accLo, productLo);
+            exactHi = _mm_add_pd(accHi, productHi);
+        }
+        else
+        {
+            result = _mm_sub_ps(acc, _mm_mul_ps(vs, rhs));
+            exactLo = _mm_sub_pd(accLo, productLo);
+            exactHi = _mm_sub_pd(accHi, productHi);
+        }
+        break;
+    }
+    }
+
+    if ((normalComponents(exactLo, exactHi) & components) == components)
+    {
+        const uint32_t negative = negativeComponents(exactLo, exactHi) & components;
+        queueFmacFlags(static_cast<uint32_t>(kReverseLanes[negative]) << 4, negative != 0u ? 0x2u : 0u, productSticky);
+        writeLanes(toAcc ? m_state.acc : m_state.vf[FD(instr)], result, components);
+        return true;
+    }
+
+    const ExactClasses classes = classifyExact(exactLo, exactHi);
+    if ((classes.atMaximum & components) != 0u)
+        return false;
+
+    // Zero and underflow store a signed zero, overflow a signed FLT_MAX, and
+    // anything else keeps the float result.
+    const __m128 maximum = _mm_and_ps(classes.overflowLanes, _mm_castsi128_ps(_mm_set1_epi32(0x7F7FFFFF)));
+    result = _mm_blendv_ps(result, _mm_or_ps(classes.signs, maximum),
+                           _mm_or_ps(classes.zeroOrUnderflow, classes.overflowLanes));
+
+    const uint32_t zero = (classes.zero | classes.underflow) & components;
+    const uint32_t mac = kReverseLanes[zero] |
+                         (static_cast<uint32_t>(kReverseLanes[classes.negative & components]) << 4) |
+                         (static_cast<uint32_t>(kReverseLanes[classes.underflow & components]) << 8) |
+                         (static_cast<uint32_t>(kReverseLanes[classes.overflow & components]) << 12);
+    queueFmacFlags(mac, statusOf(classes, components), productSticky);
+
+    writeLanes(toAcc ? m_state.acc : m_state.vf[FD(instr)], result, components);
+    return true;
+#else
+    (void)instr;
+    return false;
+#endif
+}
