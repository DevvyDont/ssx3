+    constexpr uint8_t kReverseLanes[16] = {0x0u, 0x8u, 0x4u, 0xCu, 0x2u, 0xAu, 0x6u, 0xEu,
+                                           0x1u, 0x9u, 0x5u, 0xDu, 0x3u, 0xBu, 0x7u, 0xFu};
+
+    // classifyFmacExactResult on four doubles (lo holds x and y), as component masks.
+    struct ExactClasses
+    {
+        uint32_t zero;
+        uint32_t negative;
+        uint32_t underflow;
+        uint32_t overflow;
+        uint32_t atMaximum;
+        __m128 zeroOrUnderflow; // lane masks
+        __m128 overflowLanes;
+        __m128 signs;           // the sign bit of each result
+    };
+
+    inline ExactClasses classifyExact(__m128d lo, __m128d hi)
+    {
+        const __m128d signBit = _mm_set1_pd(-0.0);
+        const __m128d maximum = _mm_set1_pd(static_cast<double>(std::numeric_limits<float>::max()));
+        const __m128d minimum = _mm_set1_pd(static_cast<double>(std::numeric_limits<float>::min()));
+        const __m128d absLo = _mm_andnot_pd(signBit, lo);
+        const __m128d absHi = _mm_andnot_pd(signBit, hi);
+        const __m128d zeroLo = _mm_cmpeq_pd(absLo, _mm_setzero_pd());
+        const __m128d zeroHi = _mm_cmpeq_pd(absHi, _mm_setzero_pd());
+        const __m128d overLo = _mm_cmpgt_pd(absLo, maximum);
+        const __m128d overHi = _mm_cmpgt_pd(absHi, maximum);
+        const __m128d underLo = _mm_andnot_pd(zeroLo, _mm_cmplt_pd(absLo, minimum));
+        const __m128d underHi = _mm_andnot_pd(zeroHi, _mm_cmplt_pd(absHi, minimum));
+        const auto bits = [](__m128d l, __m128d h)
+        {
+            return static_cast<uint32_t>(_mm_movemask_pd(l) | (_mm_movemask_pd(h) << 2));
+        };
+        const auto lanes = [](__m128d l, __m128d h)
+        {
+            return _mm_shuffle_ps(_mm_castpd_ps(l), _mm_castpd_ps(h), _MM_SHUFFLE(2, 0, 2, 0));
+        };
+
+        ExactClasses classes;
+        classes.zero = bits(zeroLo, zeroHi);
+        classes.negative = bits(lo, hi);
+        classes.underflow = bits(underLo, underHi);
+        classes.overflow = bits(overLo, overHi);
+        classes.atMaximum = bits(_mm_cmpeq_pd(absLo, maximum), _mm_cmpeq_pd(absHi, maximum));
+        classes.zeroOrUnderflow = lanes(_mm_or_pd(zeroLo, underLo), _mm_or_pd(zeroHi, underHi));
+        classes.overflowLanes = lanes(overLo, overHi);
+        // A double's sign is in the upper half of its 64 bits.
+        classes.signs = _mm_and_ps(_mm_shuffle_ps(_mm_castpd_ps(lo), _mm_castpd_ps(hi), _MM_SHUFFLE(3, 1, 3, 1)),
+                                   _mm_castsi128_ps(_mm_set1_epi32(static_cast<int32_t>(0x80000000u))));
+        return classes;
+    }
+
+    // The components whose result is a normal float below FLT_MAX: the common
+    // case, where only the sign flag can be set and the float result stands.
+    inline uint32_t normalComponents(__m128d lo, __m128d hi)
+    {
+        const __m128d signBit = _mm_set1_pd(-0.0);
+        const __m128d maximum = _mm_set1_pd(static_cast<double>(std::numeric_limits<float>::max()));
+        const __m128d minimum = _mm_set1_pd(static_cast<double>(std::numeric_limits<float>::min()));
+        const __m128d absLo = _mm_andnot_pd(signBit, lo);
+        const __m128d absHi = _mm_andnot_pd(signBit, hi);
+        const __m128d normalLo = _mm_and_pd(_mm_cmpge_pd(absLo, minimum), _mm_cmplt_pd(absLo, maximum));
+        const __m128d normalHi = _mm_and_pd(_mm_cmpge_pd(absHi, minimum), _mm_cmplt_pd(absHi, maximum));
+        return static_cast<uint32_t>(_mm_movemask_pd(normalLo) | (_mm_movemask_pd(normalHi) << 2));
+    }
+
+    inline uint32_t negativeComponents(__m128d lo, __m128d hi)
+    {
+        return static_cast<uint32_t>(_mm_movemask_pd(lo) | (_mm_movemask_pd(hi) << 2));
+    }
+
+    // Stores the components in mask.
+    inline void writeLanes(float *dst, __m128 value, uint32_t mask)
+    {
+        const __m128i laneBits = _mm_set_epi32(8, 4, 2, 1);
+        const __m128 written = _mm_castsi128_ps(
+            _mm_cmpeq_epi32(_mm_and_si128(_mm_set1_epi32(static_cast<int32_t>(mask)), laneBits), laneBits));
+        _mm_storeu_ps(dst, _mm_blendv_ps(_mm_loadu_ps(dst), value, written));
+    }
+
+    // The status flags (Z, S, U, O) of the lanes in mask.
+    inline uint32_t statusOf(const ExactClasses &classes, uint32_t mask)
+    {
+        return (((classes.zero | classes.underflow) & mask) != 0u ? 0x1u : 0u) |
+               ((classes.negative & mask) != 0u ? 0x2u : 0u) |
+               ((classes.underflow & mask) != 0u ? 0x4u : 0u) |
+               ((classes.overflow & mask) != 0u ? 0x8u : 0u);
+    }
