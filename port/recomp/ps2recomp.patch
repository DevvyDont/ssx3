+    {
+        const GSDrawState &state = batch.state;
+        const float width = static_cast<float>(state.textureWidth);
+        const float height = static_cast<float>(state.textureHeight);
+        float minQ = 0.0f;
+        float maxQ = 0.0f;
+        for (size_t i = 0; i < vertexCount; ++i)
+        {
+            const GSVertex &v = batch.vertices[i];
+            float u;
+            float t;
+            if (state.prim.fst)
